# ---- Backend ----------------------------------------------------------------
# PostgreSQL in production; SQLite default is for local evaluation only.
DATABASE_URL=postgresql+psycopg://dg:CHANGE_ME@db:5432/dg
# REQUIRED in production: long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=480
# Uploaded SDS / photos. Use an encrypted volume or mount object storage.
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=20
OCR_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# First administrator (created once at startup if it does not exist)
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=CHANGE_ME_min_10_chars

# Demonstration data + demo users (admin/approver/reviewer/operator/viewer @demo.local).
# Set SEED_DEMO_DATA=false and leave DEMO_USERS_PASSWORD empty in production.
SEED_DEMO_DATA=true
DEMO_USERS_PASSWORD=

# ---- Optional AI explanations (never used for decisions) -------------------
# none | anthropic. The Anthropic SDK reads ANTHROPIC_API_KEY from the environment.
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# NEVER set in deployments (test suite only)
# DG_TEST_MODE=
